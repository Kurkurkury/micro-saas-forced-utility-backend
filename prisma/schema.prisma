generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobConfig {
  id                   String   @id @default(cuid())
  jobKey               String   @unique
  expectedEveryMinutes Int
  graceMinutes         Int
  publicToken          String   @unique @default(cuid())
  createdAt            DateTime @default(now())
}

model JobRun {
  id        String   @id @default(cuid())
  jobKey    String
  status    String
  message   String?
  createdAt DateTime @default(now())

  @@index([jobKey, createdAt])
}

model ApiKey {
  id         String   @id @default(cuid())
  key        String   @unique
  jobKey     String
  keyPrefix  String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([jobKey])
  @@index([revokedAt])
}
